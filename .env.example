# ==============================================================================
# RenewAI — Configuration Environment Variables
# ==============================================================================

# Application Settings
APP_NAME=RenewAI
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api
SECRET_KEY=ibm-bob-hackathon-super-secret-key-2026-gujarat-renewables
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Uses SQLite locally by default (zero configuration needed).
# For PostgreSQL in Docker / Production: postgresql://renewai:renewaipass@localhost:5432/renewai_db
DATABASE_URL=sqlite:///./renewai.db

# IBM watsonx.ai & IBM Granite Configuration
# If credentials are not provided or API is unreachable, the system automatically
# engages the high-fidelity deterministic Granite Fallback Engine for 100% demo uptime.
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
WATSONX_SPACE_ID=

# Simulation & Telemetry Stream Configuration
TELEMETRY_INTERVAL_SECONDS=2
SIMULATION_ACCELERATION_FACTOR=1

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]
